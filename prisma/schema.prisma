generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantType {
  MAIN
  SUB
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum TenantDomainPurpose {
  MANAGEMENT
  WEBSITE
}

enum TenantDomainStatus {
  PENDING_VERIFICATION
  PENDING_DNS
  ACTIVE
  ERROR
  DISABLED
}

enum UserStatus {
  PENDING
  ACTIVE
  LOCKED
  INACTIVE
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

enum AuthAudience {
  ADMIN_CONSOLE
  TENANT_APP
}

enum AuthChallengeType {
  TOTP_ENROLL
  TOTP_VERIFY
  RECOVERY
}

enum SocialPlatform {
  FACEBOOK
  TELEGRAM
  YOUTUBE
  TIKTOK
  INSTAGRAM
  X
  LINKEDIN
}

model Tenant {
  uuid                       String                  @id @default(uuid()) @map("uuid")
  name                       String
  slug                       String                  @unique
  type                       TenantType
  parentTenantUuid           String?                 @map("parent_tenant_uuid")
  parentTenant               Tenant?                 @relation("TenantHierarchy", fields: [parentTenantUuid], references: [uuid])
  childTenants               Tenant[]                @relation("TenantHierarchy")
  domains                    TenantDomain[]
  localDevelopmentAssignment LocalDevelopmentTenant?
  status                     TenantStatus            @default(ACTIVE)
  settings                   Json                    @default("{}")
  branding                   TenantBranding?
  socialLinks                TenantSocialLink[]
  memberships                TenantMembership[]
  sessions                   UserSession[]
  challenges                 AuthLoginChallenge[]
  auditLogs                  AuditLog[]
  categories                 Category[]
  subcategories              Subcategory[]
  tags                       Tag[]
  articles                   Article[]
  articleViews               ArticleView[]
  articleShares              ArticleShare[]
  createdAt                  DateTime                @default(now()) @map("created_at")
  updatedAt                  DateTime                @updatedAt @map("updated_at")
  deletedAt                  DateTime?               @map("deleted_at")

  @@index([parentTenantUuid])
  @@index([type, status])
  @@map("tenants")
}

model Category {
  uuid          String                @id @default(uuid()) @map("uuid")
  tenantUuid    String                @map("tenant_uuid")
  tenant        Tenant                @relation(fields: [tenantUuid], references: [uuid], onDelete: Cascade)
  slug          String
  name          String
  translations  CategoryTranslation[]
  subcategories Subcategory[]
  articles      Article[]
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  @@unique([tenantUuid, slug])
  @@unique([uuid, tenantUuid])
  @@index([tenantUuid])
  @@map("categories")
}

model CategoryTranslation {
  uuid         String   @id @default(uuid()) @map("uuid")
  categoryUuid String   @map("category_uuid")
  category     Category @relation(fields: [categoryUuid], references: [uuid], onDelete: Cascade)
  locale       String
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([categoryUuid, locale])
  @@index([locale])
  @@map("category_translations")
}

model Subcategory {
  uuid         String                   @id @default(uuid()) @map("uuid")
  tenantUuid   String                   @map("tenant_uuid")
  tenant       Tenant                   @relation(fields: [tenantUuid], references: [uuid], onDelete: Cascade)
  categoryUuid String                   @map("category_uuid")
  category     Category                 @relation(fields: [categoryUuid], references: [uuid], onDelete: Cascade)
  slug         String
  translations SubcategoryTranslation[]
  articles     Article[]
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")

  @@unique([tenantUuid, categoryUuid, slug])
  @@unique([uuid, tenantUuid, categoryUuid])
  @@index([tenantUuid, categoryUuid])
  @@map("subcategories")
}

model SubcategoryTranslation {
  uuid            String      @id @default(uuid()) @map("uuid")
  subcategoryUuid String      @map("subcategory_uuid")
  subcategory     Subcategory @relation(fields: [subcategoryUuid], references: [uuid], onDelete: Cascade)
  locale          String
  name            String
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@unique([subcategoryUuid, locale])
  @@index([locale])
  @@map("subcategory_translations")
}

model TenantBranding {
  tenantUuid               String   @id @map("tenant_uuid")
  tenant                   Tenant   @relation(fields: [tenantUuid], references: [uuid], onDelete: Cascade)
  managementLogoPath       String?  @map("management_logo_path")
  websiteLogoPath          String?  @map("website_logo_path")
  faviconPath              String?  @map("favicon_path")
  publicWebsiteFaviconPath String?  @map("public_website_favicon_path")
  openGraphImagePath       String?  @map("open_graph_image_path")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("tenant_branding")
}

model TenantSocialLink {
  uuid       String         @id @default(uuid()) @map("uuid")
  tenantUuid String         @map("tenant_uuid")
  tenant     Tenant         @relation(fields: [tenantUuid], references: [uuid], onDelete: Cascade)
  platform   SocialPlatform
  url        String
  enabled    Boolean        @default(true)
  sortOrder  Int            @default(0) @map("sort_order")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  @@unique([tenantUuid, platform])
  @@index([tenantUuid, enabled, sortOrder])
  @@map("tenant_social_links")
}

model TenantDomain {
  uuid              String              @id @default(uuid()) @map("uuid")
  tenantUuid        String              @map("tenant_uuid")
  tenant            Tenant              @relation(fields: [tenantUuid], references: [uuid], onDelete: Cascade)
  purpose           TenantDomainPurpose
  hostname          String?             @unique
  status            TenantDomainStatus  @default(PENDING_VERIFICATION)
  verifiedAt        DateTime?           @map("verified_at")
  verificationToken String?             @map("verification_token")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@unique([tenantUuid, purpose])
  @@map("tenant_domains")
}

/// The single local routing selection. This is intentionally separate from
/// verified production domain mappings and is only used by local development.
model LocalDevelopmentTenant {
  hostname   String   @id
  tenantUuid String   @unique @map("tenant_uuid")
  tenant     Tenant   @relation(fields: [tenantUuid], references: [uuid], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("local_development_tenants")
}

model Role {
  uuid        String             @id @default(uuid()) @map("uuid")
  code        String             @unique
  name        String
  description String?
  memberships TenantMembership[]
  permissions RolePermission[]
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@map("roles")
}

model RolePermission {
  uuid       String   @id @default(uuid()) @map("uuid")
  roleUuid   String   @map("role_uuid")
  role       Role     @relation(fields: [roleUuid], references: [uuid], onDelete: Cascade)
  permission String
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([roleUuid, permission])
  @@index([permission])
  @@map("role_permissions")
}

model User {
  uuid                   String     @id @default(uuid()) @map("uuid")
  firstName              String     @map("first_name")
  lastName               String     @map("last_name")
  username               String?    @unique
  email                  String     @unique
  passwordHash           String?    @map("password_hash")
  status                 UserStatus @default(PENDING)
  createdByUuid          String?    @map("created_by")
  createdBy              User?      @relation("UserCreatedBy", fields: [createdByUuid], references: [uuid])
  createdUsers           User[]     @relation("UserCreatedBy")
  activatedAt            DateTime?  @map("activated_at")
  lastLoginAt            DateTime?  @map("last_login_at")
  sessionsRevokedAt      DateTime?  @map("sessions_revoked_at")
  failedPasswordAttempts Int        @default(0) @map("failed_password_attempts")
  failedTotpAttempts     Int        @default(0) @map("failed_totp_attempts")
  lockedUntil            DateTime?  @map("locked_until")
  createdAt              DateTime   @default(now()) @map("created_at")
  updatedAt              DateTime   @updatedAt @map("updated_at")
  deletedAt              DateTime?  @map("deleted_at")

  memberships             TenantMembership[]
  activationTokens        UserActivationToken[]
  passwordResetTokens     UserPasswordResetToken[]
  twoFactorAuth           UserTwoFactorAuth?
  recoveryCodes           UserRecoveryCode[]
  sessions                UserSession[]
  challenges              AuthLoginChallenge[]
  totpReplayGuards        AuthTotpReplayGuard[]
  auditLogs               AuditLog[]               @relation("AuditActor")
  createdActivationTokens UserActivationToken[]    @relation("ActivationCreatedBy")
  createdResetTokens      UserPasswordResetToken[] @relation("ResetCreatedBy")
  createdMemberships      TenantMembership[]       @relation("MembershipCreatedBy")
  authoredArticles        Article[]                @relation("ArticleAuthor")
  publishedArticles       Article[]                @relation("ArticlePublisher")
  scheduledArticles       Article[]                @relation("ArticleScheduler")
  articleReviews          ArticleReview[]

  @@index([status])
  @@map("users")
}

model TenantMembership {
  uuid          String           @id @default(uuid()) @map("uuid")
  userUuid      String           @map("user_uuid")
  user          User             @relation(fields: [userUuid], references: [uuid], onDelete: Cascade)
  tenantUuid    String           @map("tenant_uuid")
  tenant        Tenant           @relation(fields: [tenantUuid], references: [uuid], onDelete: Cascade)
  roleUuid      String           @map("role_uuid")
  role          Role             @relation(fields: [roleUuid], references: [uuid])
  status        MembershipStatus @default(ACTIVE)
  createdByUuid String?          @map("created_by")
  createdBy     User?            @relation("MembershipCreatedBy", fields: [createdByUuid], references: [uuid])
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@unique([userUuid, tenantUuid])
  @@index([tenantUuid])
  @@index([roleUuid])
  @@map("tenant_memberships")
}

model UserActivationToken {
  uuid           String    @id @default(uuid()) @map("uuid")
  userUuid       String    @map("user_uuid")
  user           User      @relation(fields: [userUuid], references: [uuid], onDelete: Cascade)
  tokenHash      String    @unique @map("token_hash")
  encryptedToken String?   @map("encrypted_token")
  expiresAt      DateTime  @map("expires_at")
  usedAt         DateTime? @map("used_at")
  revokedAt      DateTime? @map("revoked_at")
  createdByUuid  String?   @map("created_by")
  createdBy      User?     @relation("ActivationCreatedBy", fields: [createdByUuid], references: [uuid], onDelete: SetNull)
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([userUuid])
  @@index([expiresAt])
  @@map("user_activation_tokens")
}

model UserPasswordResetToken {
  uuid           String    @id @default(uuid()) @map("uuid")
  userUuid       String    @map("user_uuid")
  user           User      @relation(fields: [userUuid], references: [uuid], onDelete: Cascade)
  tokenHash      String    @unique @map("token_hash")
  encryptedToken String?   @map("encrypted_token")
  expiresAt      DateTime  @map("expires_at")
  usedAt         DateTime? @map("used_at")
  revokedAt      DateTime? @map("revoked_at")
  createdByUuid  String?   @map("created_by")
  createdBy      User?     @relation("ResetCreatedBy", fields: [createdByUuid], references: [uuid], onDelete: SetNull)
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([userUuid])
  @@index([expiresAt])
  @@map("user_password_reset_tokens")
}

model UserTwoFactorAuth {
  uuid                   String    @id @default(uuid()) @map("uuid")
  userUuid               String    @unique @map("user_uuid")
  user                   User      @relation(fields: [userUuid], references: [uuid], onDelete: Cascade)
  encryptedSecret        String?   @map("encrypted_secret")
  pendingEncryptedSecret String?   @map("pending_encrypted_secret")
  pendingExpiresAt       DateTime? @map("pending_expires_at")
  enabledAt              DateTime? @map("enabled_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@map("user_two_factor_auth")
}

model UserRecoveryCode {
  uuid      String    @id @default(uuid()) @map("uuid")
  userUuid  String    @map("user_uuid")
  user      User      @relation(fields: [userUuid], references: [uuid], onDelete: Cascade)
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userUuid])
  @@map("user_recovery_codes")
}

model UserSession {
  uuid             String       @id @default(uuid()) @map("uuid")
  userUuid         String       @map("user_uuid")
  user             User         @relation(fields: [userUuid], references: [uuid], onDelete: Cascade)
  tenantUuid       String       @map("tenant_uuid")
  tenant           Tenant       @relation(fields: [tenantUuid], references: [uuid], onDelete: Cascade)
  audience         AuthAudience
  refreshTokenHash String       @unique @map("refresh_token_hash")
  expiresAt        DateTime     @map("expires_at")
  revokedAt        DateTime?    @map("revoked_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  lastUsedAt       DateTime?    @map("last_used_at")

  @@index([userUuid])
  @@index([tenantUuid])
  @@index([expiresAt])
  @@map("user_sessions")
}

model AuthLoginChallenge {
  uuid         String            @id @default(uuid()) @map("uuid")
  userUuid     String            @map("user_uuid")
  user         User              @relation(fields: [userUuid], references: [uuid], onDelete: Cascade)
  tenantUuid   String            @map("tenant_uuid")
  tenant       Tenant            @relation(fields: [tenantUuid], references: [uuid], onDelete: Cascade)
  audience     AuthAudience
  type         AuthChallengeType
  tokenHash    String            @unique @map("token_hash")
  expiresAt    DateTime          @map("expires_at")
  consumedAt   DateTime?         @map("consumed_at")
  attemptCount Int               @default(0) @map("attempt_count")
  createdAt    DateTime          @default(now()) @map("created_at")

  @@index([userUuid])
  @@index([expiresAt])
  @@map("auth_login_challenges")
}

model AuthTotpReplayGuard {
  uuid      String   @id @default(uuid()) @map("uuid")
  userUuid  String   @map("user_uuid")
  user      User     @relation(fields: [userUuid], references: [uuid], onDelete: Cascade)
  timeStep  BigInt   @map("time_step")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userUuid, timeStep])
  @@map("auth_totp_replay_guards")
}

model AuditLog {
  uuid          String   @id @default(uuid()) @map("uuid")
  actorUserUuid String?  @map("actor_user_uuid")
  actorUser     User?    @relation("AuditActor", fields: [actorUserUuid], references: [uuid])
  tenantUuid    String?  @map("tenant_uuid")
  tenant        Tenant?  @relation(fields: [tenantUuid], references: [uuid])
  action        String
  targetType    String?  @map("target_type")
  targetUuid    String?  @map("target_uuid")
  requestId     String?  @map("request_id")
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([actorUserUuid])
  @@index([tenantUuid])
  @@index([createdAt])
  @@index([tenantUuid, createdAt])
  @@map("audit_logs")
}

model Tag {
  uuid         String           @id @default(uuid()) @map("uuid")
  tenantUuid   String           @map("tenant_uuid")
  tenant       Tenant           @relation(fields: [tenantUuid], references: [uuid], onDelete: Cascade)
  name         String
  slug         String
  translations TagTranslation[]
  articles     ArticleTag[]
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@unique([tenantUuid, slug])
  @@unique([uuid, tenantUuid])
  @@index([tenantUuid])
  @@index([slug])
  @@map("tags")
}

model TagTranslation {
  uuid      String   @id @default(uuid()) @map("uuid")
  tagUuid   String   @map("tag_uuid")
  tag       Tag      @relation(fields: [tagUuid], references: [uuid], onDelete: Cascade)
  locale    String
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tagUuid, locale])
  @@index([tagUuid])
  @@index([locale])
  @@map("tag_translations")
}

enum ArticleStatus {
  DRAFT
  IN_REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ArticleReviewDecision {
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
}

model Article {
  uuid              String               @id @default(uuid()) @map("uuid")
  tenantUuid        String               @map("tenant_uuid")
  tenant            Tenant               @relation(fields: [tenantUuid], references: [uuid], onDelete: Cascade)
  createdByUuid     String?              @map("created_by_uuid")
  createdBy         User?                @relation("ArticleAuthor", fields: [createdByUuid], references: [uuid], onDelete: SetNull)
  publishedByUuid   String?              @map("published_by_uuid")
  publishedBy       User?                @relation("ArticlePublisher", fields: [publishedByUuid], references: [uuid], onDelete: SetNull)
  scheduledByUuid   String?              @map("scheduled_by_uuid")
  scheduledBy       User?                @relation("ArticleScheduler", fields: [scheduledByUuid], references: [uuid], onDelete: SetNull)
  title             String
  slug              String
  summary           String?
  content           String               @default("")
  categoryUuid      String               @map("category_uuid")
  category          Category             @relation(fields: [categoryUuid, tenantUuid], references: [uuid, tenantUuid], onDelete: Restrict)
  subcategoryUuid   String               @map("subcategory_uuid")
  subcategory       Subcategory          @relation(fields: [subcategoryUuid, tenantUuid, categoryUuid], references: [uuid, tenantUuid, categoryUuid], onDelete: Restrict)
  status            ArticleStatus        @default(DRAFT)
  isBreaking        Boolean              @default(false) @map("is_breaking")
  breakingExpiresAt DateTime?            @map("breaking_expires_at")
  isFeatured        Boolean              @default(false) @map("is_featured")
  featuredImageUrl  String?              @map("featured_image_url")
  scheduledAt       DateTime?            @map("scheduled_at")
  publishedAt       DateTime?            @map("published_at")
  archivedAt        DateTime?            @map("archived_at")
  tags              ArticleTag[]
  translations      ArticleTranslation[]
  reviews           ArticleReview[]
  views             ArticleView[]
  viewCount         Int                  @default(0) @map("view_count")
  shares            ArticleShare[]
  shareCount        Int                  @default(0) @map("share_count")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  @@unique([uuid, tenantUuid])
  @@unique([tenantUuid, slug])
  @@index([tenantUuid, status, updatedAt])
  @@index([tenantUuid, status, publishedAt])
  @@index([tenantUuid, status, isBreaking, breakingExpiresAt])
  @@index([status, scheduledAt])
  @@index([tenantUuid, createdByUuid])
  @@index([tenantUuid, createdByUuid, publishedAt])
  @@map("articles")
}

model ArticleTranslation {
  uuid        String   @id @default(uuid()) @map("uuid")
  articleUuid String   @map("article_uuid")
  article     Article  @relation(fields: [articleUuid], references: [uuid], onDelete: Cascade)
  locale      String
  title       String
  summary     String?
  content     String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([articleUuid, locale])
  @@index([locale])
  @@map("article_translations")
}

model ArticleReview {
  uuid         String                @id @default(uuid()) @map("uuid")
  tenantUuid   String                @map("tenant_uuid")
  articleUuid  String                @map("article_uuid")
  article      Article               @relation(fields: [articleUuid, tenantUuid], references: [uuid, tenantUuid], onDelete: Cascade)
  reviewerUuid String?               @map("reviewer_uuid")
  reviewer     User?                 @relation(fields: [reviewerUuid], references: [uuid], onDelete: SetNull)
  decision     ArticleReviewDecision
  comment      String?
  createdAt    DateTime              @default(now()) @map("created_at")

  @@index([tenantUuid, articleUuid, createdAt])
  @@index([tenantUuid, createdAt])
  @@map("article_reviews")
}

model ArticleTag {
  articleUuid String  @map("article_uuid")
  tagUuid     String  @map("tag_uuid")
  tenantUuid  String  @map("tenant_uuid")
  article     Article @relation(fields: [articleUuid, tenantUuid], references: [uuid, tenantUuid], onDelete: Cascade)
  tag         Tag     @relation(fields: [tagUuid, tenantUuid], references: [uuid, tenantUuid], onDelete: Cascade)

  @@id([articleUuid, tagUuid])
  @@index([tagUuid, tenantUuid])
  @@map("article_tags")
}

model ArticleView {
  uuid        String   @id @default(uuid()) @map("uuid")
  tenantUuid  String   @map("tenant_uuid")
  tenant      Tenant   @relation(fields: [tenantUuid], references: [uuid], onDelete: Cascade)
  articleUuid String   @map("article_uuid")
  article     Article  @relation(fields: [articleUuid, tenantUuid], references: [uuid, tenantUuid], onDelete: Cascade)
  visitorKey  String   @map("visitor_key")
  bucketStart DateTime @map("bucket_start")
  viewedAt    DateTime @default(now()) @map("viewed_at")

  @@unique([articleUuid, visitorKey, bucketStart])
  @@index([articleUuid, viewedAt])
  @@index([tenantUuid, viewedAt])
  @@map("article_views")
}

enum ArticleSharePlatform {
  FACEBOOK
  TELEGRAM
  COPY_LINK
  NATIVE
}

model ArticleShare {
  uuid        String               @id @default(uuid()) @map("uuid")
  tenantUuid  String               @map("tenant_uuid")
  tenant      Tenant               @relation(fields: [tenantUuid], references: [uuid], onDelete: Cascade)
  articleUuid String               @map("article_uuid")
  article     Article              @relation(fields: [articleUuid, tenantUuid], references: [uuid, tenantUuid], onDelete: Cascade)
  platform    ArticleSharePlatform
  visitorKey  String               @map("visitor_key")
  bucketStart DateTime             @map("bucket_start")
  sharedAt    DateTime             @default(now()) @map("shared_at")

  @@unique([articleUuid, visitorKey, platform, bucketStart], map: "article_shares_dedup_key")
  @@index([articleUuid, sharedAt])
  @@index([tenantUuid, sharedAt])
  @@map("article_shares")
}
